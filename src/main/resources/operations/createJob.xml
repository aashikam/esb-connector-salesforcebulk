<template xmlns="http://ws.apache.org/ns/synapse" name="createJob">
    <!-- apiVersion parameter is not in the original file, so it's not added here.
         If it's required, it should be added separately.
         The task mentioned "The only remaining parameter should be apiVersion".
         Removed: operation, object, columnDelimiter, lineEnding, assignmentRuleId, externalIdFieldName, contentType (as it's part of payload) -->
    <sequence>
        <class name="org.wso2.carbon.salesforce.connector.RestURLBuilder">
            <property name="resourcePath" value="/services/data/{$version}/jobs/ingest"/>
        </class>
        <property name="DISABLE_CHUNKING" scope="axis2" type="STRING" value="true"/>
        <property name="messageType" value="application/json" scope="axis2"/>
        <property name="ContentType" value="application/json" scope="axis2"/>
        <payloadFactory media-type="json" template-type="freemarker">
            <format>
                <![CDATA[{
                    "columnDelimiter": "{get-property('columnDelimiter')}",
                    "contentType": "{get-property('contentType')}",
                    "lineEnding": "{get-property('lineEnding')}",
                    "object": "{get-property('object')}",
                    "operation": "{get-property('operation')}",
                    "externalIdFieldName": "{get-property('externalIdFieldName')}"
                }]]>
            </format>
            <args/>
        </payloadFactory>
        <header name="Authorization" scope="transport" expression="fn:concat('Bearer ', get-property('_OH_INTERNAL_ACCESS_TOKEN_'))"/>
        <header name="Accept" scope="transport" value="application/json" action="set"/>
        <call>
            <endpoint>
                <http method="post" uri-template="{uri.var.apiUrl}{+uri.var.resourcePath}"/>
            </endpoint>
        </call>
    </sequence>
</template>
